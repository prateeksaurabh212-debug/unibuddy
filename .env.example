# OpenAI API key (required for MCQ generation and letter scanning)
OPENAI_API_KEY=sk-...

# Database (Prisma)
# Local dev (SQLite):
DATABASE_URL="file:./prisma/dev.db"
# Vercel/production (Postgres): set DATABASE_URL (or DIRECT_DATABASE_URL) in Vercel
# → Project Settings → Environment Variables → add for both "Production" and "Preview",
#   and enable "Build" and "Runtime" so migrate + seed run at deploy.

# NextAuth
NEXTAUTH_SECRET=your-random-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# Owner email: only this account can access Dashboard → Users (email list)
OWNER_EMAIL=your@email.com
NEXT_PUBLIC_OWNER_EMAIL=your@email.com
